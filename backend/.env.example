# ==============================================================
# HRFlow Backend Environment Configuration (.env.example)
# Copy this file to .env and adjust values for your environment.
# ==============================================================

# ASP.NET Core Environment (Development, Staging, Production)
ASPNETCORE_ENVIRONMENT=Development

# Database Connection (SQL Server)
# Shorthand alias or ConnectionStrings__DefaultConnection
DB_CONNECTION_STRING=Server=localhost;Database=EmployeeManagementDb;Trusted_Connection=True;TrustServerCertificate=True;

# JWT Authentication Settings
JWT_SECRET_KEY=HRFlow_Enterprise_SuperSecret_SigningKey_2026_AtLeast32BytesLong!
JWT_ISSUER=EmployeeManagementApi
JWT_AUDIENCE=EmployeeManagementApp
JWT_ACCESS_TOKEN_EXPIRATION_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRATION_DAYS=7

# Allowed CORS Origins (comma-separated URLs)
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://localhost:3000

